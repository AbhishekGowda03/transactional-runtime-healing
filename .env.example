# Copy this file to `.env` and edit it. `.env` is ignored by git; never commit a real key.
# Real environment variables override this file. Lines starting with # are comments.

# --- Local model through Ollama (default, free, no key) ---
TXH_API_STYLE=openai
TXH_API_BASE=http://localhost:11434/v1
TXH_MODEL=qwen2.5-coder:7b

# --- OpenAI (remove the Ollama lines above, then fill in these) ---
# TXH_API_STYLE=openai
# TXH_API_BASE=https://api.openai.com/v1
# TXH_MODEL=<model name from the provider's page>
# TXH_API_KEY=<your key>

# --- Anthropic (Messages API) ---
# TXH_API_STYLE=anthropic
# TXH_API_BASE=https://api.anthropic.com/v1
# TXH_MODEL=<model name from the provider's page>
# TXH_API_KEY=<your key>

# Safety limits
TXH_MAX_CALLS=200
TXH_CACHE_DIR=results/llm_cache

# Sampling and repeats (optional). Temperature 0 gives the same answer every time, so repeated
# runs need a temperature above 0; the runner sets TXH_RUN_ID itself for every repeat.
# TXH_TEMPERATURE=0.7
# TXH_PROMPT=rules        # rules | minimal (minimal drops the "do not touch ..." rules)
